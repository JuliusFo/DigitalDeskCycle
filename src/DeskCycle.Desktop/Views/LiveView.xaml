<UserControl x:Class="DeskCycle.Desktop.Views.LiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             xmlns:views="clr-namespace:DeskCycle.Desktop.Views"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <views:FractionToStarConverter x:Key="FractionToStar" />

        <LinearGradientBrush x:Key="SpeedZones" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#639922" Offset="0.00" />
            <GradientStop Color="#639922" Offset="0.25" />
            <GradientStop Color="#BA7517" Offset="0.25" />
            <GradientStop Color="#BA7517" Offset="0.50" />
            <GradientStop Color="#D85A30" Offset="0.50" />
            <GradientStop Color="#D85A30" Offset="0.75" />
            <GradientStop Color="#E24B4A" Offset="0.75" />
            <GradientStop Color="#E24B4A" Offset="1.00" />
        </LinearGradientBrush>

        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="TileUnit" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="4" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,12,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Day change: asks and waits instead of deciding on its own -->
        <Border Grid.Row="0" CornerRadius="8" Padding="14,10"
                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                Visibility="{Binding ShowNewDayPrompt, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <TextBlock Text="Deine Statistik läuft noch seit gestern." FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="Auf heute zurücksetzen" Appearance="Primary"
                               Command="{Binding ResetToTodayCommand}" Margin="0,0,8,0" />
                    <ui:Button Content="Weiterzählen" Command="{Binding KeepCountingCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="8" ClipToBounds="True"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <sp:WpfPlot x:Name="SpeedPlot" />
        </Border>

        <!-- Current speed with the zoned bar -->
        <StackPanel Grid.Row="2" Margin="4,16,4,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SpeedText}" FontSize="34" FontWeight="Light"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="km/h" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,7"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <Border CornerRadius="9" Height="18" ClipToBounds="True" Margin="0,4,0,0">
                <Grid Background="{StaticResource SpeedZones}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding GaugeFraction, Converter={StaticResource FractionToStar}}" />
                        <ColumnDefinition Width="{Binding GaugeFraction, Converter={StaticResource FractionToStar}, ConverterParameter=rest}" />
                    </Grid.ColumnDefinitions>
                    <!-- The unfilled part is covered rather than recoloured,
                         so the zone boundaries stay in place. -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            Opacity="0.82" />
                </Grid>
            </Border>

            <Grid Margin="0,3,0,0">
                <TextBlock Text="0" FontSize="10" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding GaugeMaxText}" FontSize="10" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
        </StackPanel>

        <UniformGrid Grid.Row="3" Columns="4" Margin="0,12,0,0">
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Trittfrequenz" Style="{StaticResource TileLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding CadenceText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="U/min" Style="{StaticResource TileUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Distanz" Style="{StaticResource TileLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding DistanceText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="{Binding DistanceUnit}" Style="{StaticResource TileUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Aktive Dauer" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding ActiveDurationText}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Umdrehungen" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding RevolutionsText}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Ø Geschwindigkeit" Style="{StaticResource TileLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AverageSpeedText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="km/h" Style="{StaticResource TileUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Ø Trittfrequenz" Style="{StaticResource TileLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AverageRpmText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="U/min" Style="{StaticResource TileUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Spitze" Style="{StaticResource TileLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding PeakSpeedText}" Style="{StaticResource TileValue}" />
                        <TextBlock Text="km/h" Style="{StaticResource TileUnit}" VerticalAlignment="Bottom" Margin="4,0,0,4" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
                <StackPanel>
                    <TextBlock Text="Einheiten · Pausen" Style="{StaticResource TileLabel}" />
                    <TextBlock Text="{Binding SessionsAndPausesText}" Style="{StaticResource TileValue}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="4" Margin="4,12,4,0" CornerRadius="8" Padding="14"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                Visibility="{Binding HasWarning, Converter={StaticResource BooleanToVisibility}}">
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="12"
                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="DeskCycle.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Label and hint on the left, the control itself on the right -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24,12,24,20">
        <StackPanel>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Daten freigeben" Style="{StaticResource SectionTitle}" />

                    <Grid Style="{StaticResource Row}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource TextFillColorDisabledBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsApiRunning}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ApiStatusText}" Style="{StaticResource Label}" />
                        </StackPanel>

                        <ui:ToggleSwitch IsChecked="{Binding ApiEnabled, Mode=TwoWay}"
                                         HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding ApiProblem}" Margin="0,10,0,0"
                               TextWrapping="Wrap" FontSize="11"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Visibility="{Binding HasApiProblem, Converter={StaticResource BooleanToVisibility}}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Port" Style="{StaticResource Label}" />
                            <TextBlock Text="Wirkt beim nächsten Einschalten des Webservers."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                    Text="{Binding ApiPort, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Im Netzwerk erreichbar" Style="{StaticResource Label}" />
                            <TextBlock Text="Aus = nur dieser Rechner. An bindet an alle Adressen — Windows fragt dann nach der Firewall."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding ApiAllowRemote, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Messung" Style="{StaticResource SectionTitle}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Körpergewicht (kg)" Style="{StaticResource Label}" />
                            <TextBlock Text="Grundlage der Kalorienschätzung. Ohne Angabe bleibt die Kachel leer."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                    Text="{Binding BodyWeightKg, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Meter pro Umdrehung" Style="{StaticResource Label}" />
                            <TextBlock Text="Gilt rückwirkend für den gesamten Verlauf — gespeichert werden nur Umdrehungen. Das Messverfahren steht in der README."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                    Text="{Binding MetersPerRevolution, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Ende der Geschwindigkeitsleiste (km/h)" Style="{StaticResource Label}" />
                            <TextBlock Text="Nur Anzeige: legt fest, wo die Farbzonen enden."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                    Text="{Binding SpeedGaugeMaxKmh, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Verbindung" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Beides greift erst beim nächsten Verbindungsaufbau — eine laufende Aufzeichnung wird nicht unterbrochen."
                               Style="{StaticResource Hint}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="COM-Port" Style="{StaticResource Label}" />
                            <TextBlock Text="Leer = automatisch, solange genau einer vorhanden ist."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="90" VerticalAlignment="Center"
                                    Text="{Binding SerialPort, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Bluetooth-Gerätename" Style="{StaticResource Label}" />
                            <TextBlock Text="Muss mit BLE_NAME in der Firmware übereinstimmen."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:TextBox Grid.Column="1" Width="150" VerticalAlignment="Center"
                                    Text="{Binding BluetoothDeviceName, UpdateSourceTrigger=LostFocus}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Windows" Style="{StaticResource SectionTitle}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Mit Windows starten" Style="{StaticResource Label}" />
                            <TextBlock Text="Startet die Anwendung nach der Anmeldung im Hintergrund."
                                       Style="{StaticResource Hint}" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                         IsChecked="{Binding AutostartEnabled, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Hint}" Margin="4,0,0,0"
                       Text="Alles hier landet in settings.json unter %LOCALAPPDATA%\DeskCycle und übersteht eine neue Programmversion." />
        </StackPanel>
    </ScrollViewer>
</UserControl>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The platform version is stated explicitly rather than left at the WPF
         default of "windows7.0": SkiaSharp.Views.WPF (via ScottPlot) only ships
         its modern assets for windows10.0.19041. Without this, NuGet falls back
         to the old net462 asset (NU1701). Requires Windows 10 2004 as a minimum. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\deskcycle.ico</ApplicationIcon>
    <RootNamespace>DeskCycle.Desktop</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- For the optional embedded web server (Kestrel, SignalR, minimal API).
         Costs nothing as long as it is not started. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\DeskCycle.Core\DeskCycle.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Hosting is already part of the ASP.NET Core
         framework reference above; a separate package would be redundant. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
    <PackageReference Include="InTheHand.BluetoothLE" Version="4.0.44" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- .ico for the window and the executable, .png for the title bar: WPF does
         not reliably decode PNG-compressed ICO entries. -->
    <Resource Include="Assets\deskcycle.ico" />
    <Resource Include="Assets\deskcycle.png" />
  </ItemGroup>

</Project>
